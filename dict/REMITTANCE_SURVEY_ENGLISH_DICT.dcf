":[{"value":"2"}]},{"labels":[{"text":"Can understand and take part in everyday conversations"}],"pairs":[{"value":"3"}]},{"labels":[{"text":"Can understand and speak it well"}],"pairs":[{"value":"4"}]}]}]}]},{"name":"MODULE_C","labels":[{"text":"MODULE C: REMITTANCE ACTIVITY, AMOUNT, PURPOSE AND TIMING"}],"recordType":"4","occurrences":{"required":true,"maximum":1},"items":[{"name":"C1","labels":[{"text":"C1.During the past 12 months, have you sent any money to Bangladesh or personally carried money to Bangladesh for use there?"}],"contentType":"numeric","length":1,"zeroFill":false,"valueSets":[{"name":"C1_VS1","labels":[{"text":"C1.During the past 12 months, have you sent any money to Bangladesh or personally carried money to Bangladesh for use there?"}],"values":[{"labels":[{"text":"Yes"}],"pairs":[{"value":"1"}]},{"labels":[{"text":"No"}],"pairs":[{"value":"2"}]}]}]},{"name":"C2","labels":[{"text":"C2.During the past 12 months, how many times in total did you send money to Bangladesh or personally carry money to Bangladesh?"}],"contentType":"numeric","length":2,"zeroFill":false,"valueSets":[{"name":"C2_VS2","labels":[{"text":"C2.During the past 12 months, how many times in total did you send money to Bangladesh or personally carry money to Bangladesh?"}],"values":[{"labels":[{"text":""}],"pairs":[{"range":["1","50"]}]}]}]},{"name":"C3_AMOUNT","labels":[{"text":"C3.1 During the past 12 months, approximately how much money in total did you send to Bangladesh or personally carry to Bangladesh?"}],"contentType":"numeric","length":8,"zeroFill":false,"valueSets":[{"name":"C3_AMOUNT_VS1","labels":[{"text":"C3.1 During the past 12 months, approximately how much money in total did you send to Bangladesh or personally carry to Bangladesh?"}],"values":[{"labels":[{"text":"Enter total amount"}],"pairs":[{"range":["0","99999999"]}]}]}]},{"name":"C3_CURRENCY","labels":[{"text":"C3.2 Select the currency"}],"contentType":"numeric","length":1,"zeroFill":false,"valueSets":[{"name":"C3_CURRENCY_VS1","labels":[{"text":"C3.2 Select the currency"}],"values":[{"labels":[{"text":"Pound Sterling (GBP)"}],"pairs":[{"value":"1"}]},{"labels":[{"text":"Malaysian Ringgit (MYR)"}],"pairs":[{"value":"2"}]},{"labels":[{"text":"US Dollar (USD)"}],"pairs":[{"value":"3"}]},{"labels":[{"text":"UAE Dirham (AED)"}],"pairs":[{"value":"4"}]},{"labels":[{"text":"Saudi Riyal (SAR)"}],"pairs":[{"value":"5"}]}]}]},{"name":"C4","labels":[{"text":"C4.To the best of your knowledge, what was the money that you sent or carried to Bangladesh during the past 12 months used for?"}],"contentType":"alpha","length":14,"valueSets":[{"name":"C4_VS1","labels":[{"text":"C4.To the best of your knowledge, what was the money that you sent or carried to Bangladesh during the past 12 months used for?"}],"values":[{"labels":[{"text":"Day-to-day household expenses (food, clothing, rent, utilities, other household bills)"}],"pairs":[{"value":"1"}]},{"labels":[{"text":"Education or training expenses for children or other family members"}],"pairs":[{"value":"2"}]},{"labels":[{"text":"Medical or healthcare expenses"}],"pairs":[{"value":"3"}]},{"labels":[{"text":"Repayment of loans, debts, or installments, including migration-related debt"}],"pairs":[{"value":"4"}]},{"labels":[{"text":"Construction/repair of a house or apartment, or purchase of land, a house, or an apartment"}],"pairs":[{"value":"5"}]},{"labels":[{"text":"Savings or deposits in a bank or other financial account"}],"pairs":[{"value":"6"}]},{"labels":[{"text":"Investment in a business, agriculture, farming, or another income-generating activity"}],"pairs":[{"value":"7"}]},{"labels":[{"text":"Migration-related expenses for another family member to travel or move abroad"}],"pairs":[{"value":"8"}]},{"labels":[{"text":"Weddings, Eid, religious occasions, or other social events"}],"pairs":[{"value":"9"}]},{"labels":[{"text":"Emergency needs, accidents, or disaster-related expenses"}],"pairs":[{"value":"A"}]},{"labels":[{"text":"Financial support to relatives or other individuals outside the immediate household"}],"pairs":[{"value":"B"}]},{"labels":[{"text":"Zakat, charitable giving, or other religious/social contributions"}],"pairs":[{"value":"C"}]},{"labels":[{"text":"Do not know how the money was used"}],"pairs":[{"value":"X"}]},{"labels":[{"text":"Other"}],"pairs":[{"value":"Z"}]}]}]},{"name":"C5","labels":[{"text":"C5.When or under what circumstances do you usually send or carry money to Bangladesh?"}],"contentType":"alpha","length":9,"valueSets":[{"name":"C5_VS1","labels":[{"text":"C5.When or under what circumstances do you usually send or carry money to Bangladesh?"}],"values":[{"labels":[{"text":"Regularly, usually every month or after receiving salary or other income"}],"pairs":[{"value":"1"}]},{"labels":[{"text":"Regularly, but at intervals of two months or longer"}],"pairs":[{"value":"2"}]},{"labels":[{"text":"When my family or the person I support tells me that money is needed"}],"pairs":[{"value":"3"}]},{"labels":[{"text":"When there is an emergency or unexpected need"}],"pairs":[{"value":"4"}]},{"labels":[{"text":"During Eid, religious/social occasions, or other special events"}],"pairs":[{"value":"5"}]},{"labels":[{"text":"When money is needed for a major expense, such as education, medical treatment, housing, or business"}],"pairs":[{"value":"6"}]},{"labels":[{"text":"I usually carry money with me when I travel to Bangladesh"}],"pairs":[{"value":"7"}]},{"labels":[{"text":"I do not follow a fixed schedule; I send money when my income and circumstances allow"}],"pairs":[{"value":"8"}]},{"labels":[{"text":"Other"}],"pairs":[{"value":"Z"}]}]}]},{"name":"C6","labels":[{"text":"C6.During the past 12 months, why did you not send or carry any money to Bangladesh?"}],"contentType":"alpha","length":12,"valueSets":[{"name":"C6_VS1","labels":[{"text":"C6.During the past 12 months, why did you not send or carry any money to Bangladesh?"}],"values":[{"labels":[{"text":"My income was low, irregular, or I had no income"}],"pairs":[{"value":"1"}]},{"labels":[{"text":"My own essential living expenses, or those of family members living with me, were too high"}],"pairs":[{"value":"2"}]},{"labels":[{"text":"My family in Bangladesh did not need financial support, or no one there depends on me financially"}],"pairs":[{"value":"3"}]},{"labels":[{"text":"My spouse or the family members I support live with me or in another country"}],"pairs":[{"value":"4"}]},{"labels":[{"text":"I needed to repay migration-related debt or other loans/borrowing"}],"pairs":[{"value":"5"}]},{"labels":[{"text":"I had only recently arrived in this country or had not yet started earning a regular income"}],"pairs":[{"value":"6"}]},{"labels":[{"text":"Identification documents, a bank account, or other required documentation made it difficult to send money"}],"pairs":[{"value":"7"}]},{"labels":[{"text":"I could not find a suitable or convenient remittance service, or faced difficulties using available services"}],"pairs":[{"value":"8"}]},{"labels":[{"text":"Fees or overall costs were too high, or the exchange rate was not favorable"}],"pairs":[{"value":"9"}]},{"labels":[{"text":"I planned to send the money later or carry it when traveling to Bangladesh"}],"pairs":[{"value":"A"}]},{"labels":[{"text":"Instead of sending money, I supported my family through goods, gifts, or other assistance"}],"pairs":[{"value":"B"}]},{"labels":[{"text":"Other"}],"pairs":[{"value":"Z"}]}]}]},{"name":"C7","labels":[{"text":"C7.Before the past 12 months, had you ever sent money to Bangladesh or carried money to Bangladesh for use there?"}],"contentType":"numeric","length":1,"zeroFill":false,"valueSets":[{"name":"C7_VS1","labels":[{"text":"C7.Before the past 12 months, had you ever sent money to Bangladesh or carried money to Bangladesh for use there?"}],"values":[{"labels":[{"text":"Yes"}],"pairs":[{"value":"1"}]},{"labels":[{"text":"No"}],"pairs":[{"value":"2"}]}]}]},{"name":"C8_DOYOUREMEBER","labels":[{"text":"