available if a problem occurred"}],"pairs":[{"value":"7"}]},{"labels":[{"text":"The recipient in Bangladesh could easily receive or withdraw the money"}],"pairs":[{"value":"8"}]},{"labels":[{"text":"A branch or agent was conveniently located or easy to access"}],"pairs":[{"value":"9"}]},{"labels":[{"text":"The service was available at convenient times"}],"pairs":[{"value":"A"}]},{"labels":[{"text":"It was recommended by family, friends, relatives, or colleagues"}],"pairs":[{"value":"B"}]},{"labels":[{"text":"The transaction was eligible for the Government of Bangladesh's remittance incentive"}],"pairs":[{"value":"C"}]},{"labels":[{"text":"Other"}],"pairs":[{"value":"Z"}]}]}]},{"name":"E2_01","labels":[{"text":"E2.1 How much do you trust bank branch or counter as a safe way to send money to Bangladesh?"}],"contentType":"numeric","length":2,"zeroFill":false,"valueSets":[{"name":"E2_01_VS1","labels":[{"text":"E2.1 How much do you trust bank branch or counter as a safe way to send money to Bangladesh?"}],"values":[{"labels":[{"text":"Do not trust at all"}],"pairs":[{"value":"1"}]},{"labels":[{"text":"Trust a little"}],"pairs":[{"value":"2"}]},{"labels":[{"text":"Trust somewhat"}],"pairs":[{"value":"3"}]},{"labels":[{"text":"Trust a lot"}],"pairs":[{"value":"4"}]},{"labels":[{"text":"Do not know enough about this method to assess it"}],"pairs":[{"value":"98"}]}]}]},{"name":"E2_02","labels":[{"text":"E2.2 How much do you trust bank app or internet banking as a safe way to send money to Bangladesh?"}],"contentType":"numeric","length":2,"zeroFill":false,"valueSets":[{"name":"E2_02_VS1","labels":[{"text":"E2.2 How much do you trust bank app or internet banking as a safe way to send money to Bangladesh?"}],"values":[{"labels":[{"text":"Do not trust at all"}],"pairs":[{"value":"1"}]},{"labels":[{"text":"Trust a little"}],"pairs":[{"value":"2"}]},{"labels":[{"text":"Trust somewhat"}],"pairs":[{"value":"3"}]},{"labels":[{"text":"Trust a lot"}],"pairs":[{"value":"4"}]},{"labels":