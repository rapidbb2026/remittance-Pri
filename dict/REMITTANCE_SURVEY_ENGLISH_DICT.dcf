?"}],"contentType":"numeric","length":2,"zeroFill":false,"valueSets":[{"name":"F6_VS1","labels":[{"text":"F6.Does this person have any of the following financial accounts in their own name?"}],"values":[{"labels":[{"text":"Bank account only"}],"pairs":[{"value":"1"}]},{"labels":[{"text":"Mobile financial services (MFS) account only, such as bKash, Nagad, or Rocket"}],"pairs":[{"value":"2"}]},{"labels":[{"text":"Both a bank account and an MFS account"}],"pairs":[{"value":"3"}]},{"labels":[{"text":"Neither a bank account nor an MFS account"}],"pairs":[{"value":"4"}]},{"labels":[{"text":"Do not know"}],"pairs":[{"value":"98"}]}]}]},{"name":"F7","labels":[{"text":"F7.To the best of your knowledge, how does this person usually prefer to receive the money you send?"}],"contentType":"numeric","length":2,"zeroFill":false,"valueSets":[{"name":"F7_VS1","labels":[{"text":"F7.To the best of your knowledge, how does this person usually prefer to receive the money you send?"}],"values":[{"labels":[{"text":"Directly into their bank account"}],"pairs":[{"value":"1"}]},{"labels":[{"text":"Directly into their MFS account, such as bKash, Nagad, or Rocket"}],"pairs":[{"value":"2"}]},{"labels":[{"text":"In cash collected from a bank, exchange house, MTO, or agent"}],"pairs":[{"value":"3"}]},{"labels":[{"text":"In cash delivered to their home or another location"}],"pairs":[{"value":"4"}]},{"labels":[{"text":"In cash brought by a relative, friend, or another traveler"}],"pairs":[{"value":"5"}]},{"labels":[{"text":"No particular preference"}],"pairs":[{"value":"6"}]},{"labels":[{"text":"Do not know"}],"pairs":[{"value":"98"}]}]}]},{"name":"F8","labels":[{"text":"F8.Suppose your income stopped completely today and you received no new income. Using only your current savings, for approximately how long could you cover essential living expenses?"}],"contentType":"numeric","length":2,"zeroFill":false,"valueSets":[{"name":"F8_VS1","labels":[{"text":"F8.Suppose your income stopped completely today and you received no new income. Using only your current savings, for approximately how long could you cover essential living expenses?"}],"values":[{"labels":[{"text":"I have no savings"}],"pairs":[{"value":"1"}]},{"labels":[{"text":"Less than 1 month"}],"pairs":[{"value":"2"}]},{"labels":[{"text":"1 to 2 months"}],"pairs":[{"value":"3"}]},{"labels":[{"text":"3 to 5 months"}],"pairs":[{"value":"4"}]},{"labels":[{"text":"6 months or more"}],"pairs":[{"value":"5"}]},{"labels":[{"text":"Do not know"}],"pairs":[{"value":"98"}]}]}]}]},{"name":"MODULE_G","labels":[{"text":"MODULE G: USE OF REMITTANCES IN BANGLADESH AND POLICY PRIORITIES"}],"recordType":"8","occurrences":{"required":true,"maximum":1},"items":[{"name":"G1","labels":[{"text":"G1.Approximately how much of your family's regular monthly household expenses in Bangladesh are covered by the money you send?"}],"contentType":"numeric","length":2,"zeroFill":false,"valueSets":[{"name":"G1_VS1","labels":[{"text":"G1.Approximately how much of your family's regular monthly household expenses in Bangladesh are covered by the money you send?"}],"values":[{"labels":[{"text":"About one-quarter"}],"pairs":[{"value":"1"}]},{"labels":[{"text":"About half"}],"pairs":[{"value":"2"}]},{"labels":[{"text":"About three-quarters"}],"pairs":[{"value":"3"}]},{"labels":[{"text":"Almost all"}],"pairs":[{"value":"4"}]},{"labels":[{"text":"The money I send is not used for my family's regular monthly household expenses"}],"pairs":[{"value":"5"}]},{"labels":[{"text":"Do not know / cannot estimate"}],"pairs":[{"value":"98"}]}]}]},{"name":"G2","labels":[{"text":"G2.Who mainly decides how your family's regular household expenses in Bangladesh are managed?"}],"contentType":"numeric","length":2,"zeroFill":false,"valueSets":[{"name":"G2_VS1","labels":[{"text":"G2.Who mainly decides how your family's regular household expenses in Bangladesh are managed?"}],"values":[{"labels":[{"text":"My husband/wife"}],"pairs":[{"value":"1"}]},{"labels":[{"text